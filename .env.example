# Optional: endpoint the contact form POSTs to (Formspree, a serverless function, etc).
# Frontend env vars are public — never put secrets here.
VITE_CONTACT_ENDPOINT=/api/contact

# --- SMTP (contact form email sending, read server-side only by api/contact.ts) ---
# Never prefix these with VITE_ — that would ship them to the browser bundle.
# Set the real values in Vercel Project Settings > Environment Variables, and in a
# local, git-ignored .env for `vercel dev`. Do not commit real credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Zobix Solutions
